<?xml version="1.0" ?>
<sdf version="1.6">
  <world name="v2x_city_world">

    <include>
      <uri>model://sun</uri>
    </include>

    <include>
      <uri>model://ground_plane</uri>
    </include>

    <gui fullscreen="0">
      <camera name="user_camera">
        <pose>0 -15 10 0 0.75 1.5707</pose>
      </camera>
    </gui>

    <!-- ================= ROADS ================= -->

    <model name="main_horizontal_road">
      <static>true</static>
      <pose>0 0 0.01 0 0 0</pose>
      <link name="link">
        <visual name="road">
          <geometry><box><size>30 5.0 0.02</size></box></geometry>
          <material>
            <ambient>0.025 0.025 0.025 1</ambient>
            <diffuse>0.025 0.025 0.025 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <model name="main_vertical_road">
      <static>true</static>
      <pose>0 0 0.012 0 0 0</pose>
